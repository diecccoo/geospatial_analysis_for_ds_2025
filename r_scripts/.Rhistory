logLik <- function(p) {
k <- 10  # Number of successes
n <- 30  # Total number of trials
return(k * log(p) + (n - k) * log(1 - p))  # Log-likelihood formula
}
logLik1 <- function(p) {
k <- 10  # Number of successes
n <- 30  # Total number of trials
return(dbinom(k, n, p, log=T))  # Log-likelihood formula
}
