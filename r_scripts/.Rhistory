library(idefix) #package containing functions to implement
install.packages("idefix")
library(idefix) #package containing functions to implement
# Firstly, we need to create the full design that considers all possible profiles
# using the function Profiles()
attrib <- c(3, 3, 3, 4, 4) # specify 4 attributes with respectively 3, 3, 2 and 2 levels.
dcode <- rep("D", length=5) # specify to treat attributes as dummy variables
prof.set <- Profiles(lvls=attrib, coding=dcode) # create the set of all possible profiles
# coded in the form of a model matrix
head(prof.set)
# Secondly, we specify the distributions of the model parameters
# Nuovi valori a priori per 12 parametri (ad esempio)
mu <- c(0.2, 0.3, 0.8, -0.5, -1.5, 0.5, 0.1, -0.2, 1.0, -0.4, 0.6, 0.9) # Vettore di 12 medie
sigma <- diag(length(mu)) # Matrice di covarianza 12x12
# Inserisci le tue covarianze note, altrimenti lascia la matrice diagonale (indipendenza)
# Esempio: Inseriamo una covarianza tra il primo e il secondo parametro:
sigma[2,1] <- sigma[1,2] <- 0.5
# Thirdly, we generate individual values of parameters according to the previously
# specified distributions, using the multivariate normal distribution
library(MASS)
set.seed(8756)
draws <- mvrnorm(n=50, mu=mu, Sigma=sigma) # generate value for 50 individuals
# Finally, we select the choice set design that minimizes (conditioned on the prior distribution)
# the global variance of model parameters' estimates
# We specify, in particular a choice set with 15 questions and 3 alternatives per question
optDes12 <- Modfed(cand.set=prof.set, n.sets=12, n.alts=3, par.draws=draws)
head(optDes$BestDesign$design)
